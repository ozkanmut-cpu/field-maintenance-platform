[Unit]
Description=SAP confirmation DOM sync
After=network-online.target
Wants=network-online.target
[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/field-maintenance/sap-runtime
EnvironmentFile=/opt/field-maintenance/sap-runtime/.sap_credentials
ExecStart=/usr/bin/flock -n /run/sap-teyit-dom-sync.lock /usr/bin/node /opt/field-maintenance/sap-runtime/sap_prod_runner.js
TimeoutStartSec=180
PrivateTmp=no
NoNewPrivileges=true
