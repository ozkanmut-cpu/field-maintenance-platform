generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  TECHNICIAN
}

enum PointStatus {
  ACTIVE
  PASSIVE
  CANCELLED
}

enum MaintenanceType {
  STANDARD
  SMARTCLEAN
}

enum VisitStatus {
  VALID
  REVERSED
}

enum PaperworkStatus {
  PENDING
  PRESENT
  MISSING
}

enum PaperworkKind {
  SERVICE_SLIP
  CONFIRMATION
}

enum LocationSource {
  UNKNOWN
  GOOGLE_MATCH
  FIELD_CONFIRMED
  MANUAL
}

enum AttemptReason {
  BUSINESS_CLOSED
  AUTHORIZED_PERSON_UNAVAILABLE
  ACCESS_FAILED
  OTHER
}

enum ReviewDecision {
  NO_ISSUE
  KEEP_LOCATION_EXCLUDED
  NEEDS_FOLLOWUP
}

enum PointAssignmentKind {
  POINT_OVERRIDE
  TEMPORARY
}

enum NonMaintenanceVisitPurpose {
  BREAKDOWN
  SURVEY
  INSTALLATION
  REMOVAL
}

enum ProspectSource {
  GOOGLE_MAPS
  MANUAL
  EFESIM
}

enum ProspectStatus {
  CANDIDATE
  CONVERTED
  ARCHIVED
}

enum ProspectVisitPurpose {
  SURVEY
  INSTALLATION
}

enum MaintenanceObligationStatus {
  OPEN
  COMPLETED
  MISSED
}

enum AttemptReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                          String                        @id @default(uuid()) @db.Uuid
  name                        String
  username                    String                        @unique
  role                        UserRole
  active                      Boolean                       @default(true)
  passwordHash                String?                       @map("password_hash")
  tokenVersion                Int                           @default(0) @map("token_version")
  lastLoginAt                 DateTime?                     @map("last_login_at")
  createdAt                   DateTime                      @default(now()) @map("created_at")
  updatedAt                   DateTime                      @updatedAt @map("updated_at")
  visits                      MaintenanceVisit[]
  attempts                    MaintenanceAttempt[]
  nonMaintenanceVisits        NonMaintenanceVisit[]
  prospectVisits              ProspectVisit[]
  prospectsCreated            ProspectCustomer[]            @relation("ProspectCreatedBy")
  regions                     Region[]                      @relation("RegionTechnician")
  paperworkChanges            PaperworkStatusHistory[]      @relation("PaperworkChangedBy")
  reviewResolutions           MaintenanceReviewResolution[] @relation("ReviewResolvedBy")
  pointAliases                PointAlias[]                  @relation("PointAliasCreatedBy")
  pointAssignments            PointAssignment[]             @relation("PointAssignedTechnician")
  assignmentsCreated          PointAssignment[]             @relation("PointAssignmentCreatedBy")
  auditEvents                 AdminAuditLog[]               @relation("AuditActor")
  helpGiven                   TechnicianHelpPermission[]    @relation("HelpHelper")
  helpReceived                TechnicianHelpPermission[]    @relation("HelpTarget")
  assistedMaintenanceVisits   MaintenanceVisit[]            @relation("AssistedForTechnician")
  assistedMaintenanceAttempts MaintenanceAttempt[]          @relation("AssistedAttemptForTechnician")
  reviewedAttempts            MaintenanceAttempt[]          @relation("AttemptReviewedBy")

  @@map("users")
}

model TechnicianHelpPermission {
  id        String   @id @default(uuid()) @db.Uuid
  helperId  String   @map("helper_id") @db.Uuid
  helper    User     @relation("HelpHelper", fields: [helperId], references: [id], onDelete: Cascade)
  targetId  String   @map("target_id") @db.Uuid
  target    User     @relation("HelpTarget", fields: [targetId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([helperId, targetId])
  @@index([targetId])
  @@map("technician_help_permissions")
}

model Region {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @unique
  technicianId String?  @map("technician_id") @db.Uuid
  technician   User?    @relation("RegionTechnician", fields: [technicianId], references: [id])
  points       Point[]
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("regions")
}

model Point {
  id                    String                  @id @default(uuid()) @db.Uuid
  code                  String
  name                  String
  address               String?
  regionId              String?                 @map("region_id") @db.Uuid
  region                Region?                 @relation(fields: [regionId], references: [id])
  status                PointStatus             @default(ACTIVE)
  maintenanceType       MaintenanceType         @default(STANDARD) @map("maintenance_type")
  maintenanceWeek       Int?                    @map("maintenance_week")
  smartcleanReferenceAt DateTime?               @map("smartclean_reference_at") @db.Date
  canonicalLatitude     Decimal?                @map("canonical_latitude") @db.Decimal(9, 6)
  canonicalLongitude    Decimal?                @map("canonical_longitude") @db.Decimal(9, 6)
  locationSource        LocationSource          @default(UNKNOWN) @map("location_source")
  locationConfidence    Int                     @default(0) @map("location_confidence")
  googlePlaceId         String?                 @map("google_place_id")
  googleBusinessName    String?                 @map("google_business_name")
  coolerCount           Int?                    @map("cooler_count")
  towerCount            Int?                    @map("tower_count")
  tapCount              Int?                    @map("tap_count")
  smarttapCount         Int?                    @map("smarttap_count")
  equipmentVerifiedAt   DateTime?               @map("equipment_verified_at")
  equipmentVerifiedById String?                 @map("equipment_verified_by_id") @db.Uuid
  createdAt             DateTime                @default(now()) @map("created_at")
  updatedAt             DateTime                @updatedAt @map("updated_at")
  deletedAt             DateTime?               @map("deleted_at")
  obligations           MaintenanceObligation[]
  visits                MaintenanceVisit[]
  attempts              MaintenanceAttempt[]
  nonMaintenanceVisits  NonMaintenanceVisit[]
  aliases               PointAlias[]
  assignments           PointAssignment[]
  convertedFromProspect ProspectCustomer?       @relation("ProspectConvertedPoint")

  @@index([code])
  @@index([regionId, status])
  @@index([maintenanceType, maintenanceWeek])
  @@map("points")
}

model ProspectCustomer {
  id               String          @id @default(uuid()) @db.Uuid
  name             String
  sapNo            String?         @map("sap_no")
  source           ProspectSource
  status           ProspectStatus  @default(CANDIDATE)
  googlePlaceId    String?         @map("google_place_id")
  address          String?
  latitude         Decimal         @db.Decimal(9, 6)
  longitude        Decimal         @db.Decimal(9, 6)
  createdById      String          @map("created_by_id") @db.Uuid
  createdBy        User            @relation("ProspectCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  convertedAt      DateTime?       @map("converted_at")
  convertedPointId String?         @unique @map("converted_point_id") @db.Uuid
  convertedPoint   Point?          @relation("ProspectConvertedPoint", fields: [convertedPointId], references: [id])
  visits           ProspectVisit[]

  @@index([status, createdAt])
  @@index([sapNo])
  @@index([googlePlaceId])
  @@map("prospect_customers")
}

model ProspectVisit {
  id                 String               @id @default(uuid()) @db.Uuid
  prospectId         String               @map("prospect_id") @db.Uuid
  prospect           ProspectCustomer     @relation(fields: [prospectId], references: [id])
  technicianId       String               @map("technician_id") @db.Uuid
  technician         User                 @relation(fields: [technicianId], references: [id])
  purpose            ProspectVisitPurpose
  note               String?
  latitude           Decimal              @db.Decimal(9, 6)
  longitude          Decimal              @db.Decimal(9, 6)
  accuracyMeters     Decimal?             @map("accuracy_meters") @db.Decimal(8, 2)
  locationCapturedAt DateTime             @map("location_captured_at")
  visitedAt          DateTime             @default(now()) @map("visited_at")
  idempotencyKey     String               @unique @map("idempotency_key")
  createdAt          DateTime             @default(now()) @map("created_at")

  @@index([prospectId, visitedAt])
  @@index([technicianId, visitedAt])
  @@map("prospect_visits")
}

model PointAlias {
  id          String   @id @default(uuid()) @db.Uuid
  pointId     String   @map("point_id") @db.Uuid
  point       Point    @relation(fields: [pointId], references: [id], onDelete: Cascade)
  alias       String
  normalized  String
  createdById String   @map("created_by_id") @db.Uuid
  createdBy   User     @relation("PointAliasCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([pointId, normalized])
  @@index([normalized])
  @@map("point_aliases")
}

model PointAssignment {
  id            String              @id @default(uuid()) @db.Uuid
  pointId       String              @map("point_id") @db.Uuid
  point         Point               @relation(fields: [pointId], references: [id], onDelete: Cascade)
  technicianId  String              @map("technician_id") @db.Uuid
  technician    User                @relation("PointAssignedTechnician", fields: [technicianId], references: [id])
  kind          PointAssignmentKind
  startsAt      DateTime            @map("starts_at")
  endsAt        DateTime?           @map("ends_at")
  active        Boolean             @default(true)
  reason        String?
  createdById   String              @map("created_by_id") @db.Uuid
  createdBy     User                @relation("PointAssignmentCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime            @default(now()) @map("created_at")
  deactivatedAt DateTime?           @map("deactivated_at")

  @@index([pointId, active, startsAt, endsAt])
  @@index([technicianId, active])
  @@map("point_assignments")
}

model AdminAuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  action     String
  actorId    String   @map("actor_id") @db.Uuid
  actor      User     @relation("AuditActor", fields: [actorId], references: [id])
  oldValue   Json?    @map("old_value")
  newValue   Json?    @map("new_value")
  note       String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@map("admin_audit_logs")
}

model MaintenanceObligation {
  id                String                      @id @default(uuid()) @db.Uuid
  pointId           String                      @map("point_id") @db.Uuid
  point             Point                       @relation(fields: [pointId], references: [id])
  cycleKey          String                      @map("cycle_key")
  dueStart          DateTime                    @map("due_start") @db.Date
  dueEnd            DateTime                    @map("due_end") @db.Date
  status            MaintenanceObligationStatus @default(OPEN)
  completedAt       DateTime?                   @map("completed_at")
  resolvedAt        DateTime?                   @map("resolved_at")
  resolvedByVisitId String?                     @map("resolved_by_visit_id") @db.Uuid
  resolvedByAttemptId String?                   @map("resolved_by_attempt_id") @db.Uuid
  createdAt         DateTime                    @default(now()) @map("created_at")
  visits            MaintenanceVisit[]

  @@unique([pointId, cycleKey])
  @@index([status, dueStart, dueEnd])
  @@index([resolvedByVisitId])
  @@index([resolvedByAttemptId])
  @@map("maintenance_obligations")
}

model MaintenanceVisit {
  id                       String                        @id @default(uuid()) @db.Uuid
  pointId                  String                        @map("point_id") @db.Uuid
  point                    Point                         @relation(fields: [pointId], references: [id])
  technicianId             String                        @map("technician_id") @db.Uuid
  technician               User                          @relation(fields: [technicianId], references: [id])
  assistedForTechnicianId  String?                       @map("assisted_for_technician_id") @db.Uuid
  assistedForTechnician    User?                         @relation("AssistedForTechnician", fields: [assistedForTechnicianId], references: [id])
  obligationId             String?                       @map("obligation_id") @db.Uuid
  obligation               MaintenanceObligation?        @relation(fields: [obligationId], references: [id])
  performedAt              DateTime                      @map("performed_at")
  recordedAtServer         DateTime                      @default(now()) @map("recorded_at_server")
  deviceRecordedAt         DateTime?                     @map("device_recorded_at")
  enteredLate              Boolean                       @default(false) @map("entered_late")
  lateEntryMinutes         Int?                          @map("late_entry_minutes")
  lateEntryReason          String?                       @map("late_entry_reason")
  latitude                 Decimal                       @db.Decimal(9, 6)
  longitude                Decimal                       @db.Decimal(9, 6)
  accuracyMeters           Decimal?                      @map("accuracy_meters") @db.Decimal(8, 2)
  locationCapturedAt       DateTime                      @map("location_captured_at")
  locationLearningEligible Boolean                       @default(true) @map("location_learning_eligible")
  suspiciousBatch          Boolean                       @default(false) @map("suspicious_batch")
  reviewRecommended        Boolean                       @default(false) @map("review_recommended")
  reviewReason             String?                       @map("review_reason")
  status                   VisitStatus                   @default(VALID)
  reversedAt               DateTime?                     @map("reversed_at")
  reversedByUserId         String?                       @map("reversed_by_user_id") @db.Uuid
  serviceSlipStatus        PaperworkStatus               @default(PENDING) @map("service_slip_status")
  confirmationStatus       PaperworkStatus               @default(PENDING) @map("confirmation_status")
  coolerCount              Int?                          @map("cooler_count")
  towerCount               Int?                          @map("tower_count")
  tapCount                 Int?                          @map("tap_count")
  smarttapCount            Int?                          @map("smarttap_count")
  equipmentConfirmed       Boolean                       @default(false) @map("equipment_confirmed")
  idempotencyKey           String                        @unique @map("idempotency_key")
  createdAt                DateTime                      @default(now()) @map("created_at")
  paperworkHistory         PaperworkStatusHistory[]
  reviewResolutions        MaintenanceReviewResolution[]

  @@index([pointId, performedAt])
  @@index([technicianId, performedAt])
  @@index([assistedForTechnicianId, performedAt])
  @@index([serviceSlipStatus, confirmationStatus])
  @@map("maintenance_visits")
}

model MaintenanceAttempt {
  id                      String        @id @default(uuid()) @db.Uuid
  pointId                 String        @map("point_id") @db.Uuid
  point                   Point         @relation(fields: [pointId], references: [id])
  technicianId            String        @map("technician_id") @db.Uuid
  technician              User          @relation(fields: [technicianId], references: [id])
  assistedForTechnicianId String?       @map("assisted_for_technician_id") @db.Uuid
  assistedForTechnician   User?         @relation("AssistedAttemptForTechnician", fields: [assistedForTechnicianId], references: [id])
  reason                  AttemptReason
  note                    String?
  latitude                Decimal       @db.Decimal(9, 6)
  longitude               Decimal       @db.Decimal(9, 6)
  accuracyMeters          Decimal?      @map("accuracy_meters") @db.Decimal(8, 2)
  locationCapturedAt      DateTime      @map("location_captured_at")
  attemptedAt             DateTime      @default(now()) @map("attempted_at")
  idempotencyKey          String        @unique @map("idempotency_key")
  createdAt               DateTime      @default(now()) @map("created_at")
  reviewStatus            AttemptReviewStatus @default(PENDING) @map("review_status")
  reviewedAt              DateTime?     @map("reviewed_at")
  reviewedById            String?       @map("reviewed_by_id") @db.Uuid
  reviewedBy               User?         @relation("AttemptReviewedBy", fields: [reviewedById], references: [id])
  reviewNote              String?       @map("review_note")
  closedDueDate           DateTime?     @map("closed_due_date") @db.Date

  @@index([pointId, attemptedAt])
  @@index([technicianId, attemptedAt])
  @@index([assistedForTechnicianId, attemptedAt])
  @@index([reviewStatus, attemptedAt])
  @@map("maintenance_attempts")
}

model NonMaintenanceVisit {
  id                 String                     @id @default(uuid()) @db.Uuid
  pointId            String                     @map("point_id") @db.Uuid
  point              Point                      @relation(fields: [pointId], references: [id])
  technicianId       String                     @map("technician_id") @db.Uuid
  technician         User                       @relation(fields: [technicianId], references: [id])
  purpose            NonMaintenanceVisitPurpose
  note               String?
  latitude           Decimal                    @db.Decimal(9, 6)
  longitude          Decimal                    @db.Decimal(9, 6)
  accuracyMeters     Decimal?                   @map("accuracy_meters") @db.Decimal(8, 2)
  locationCapturedAt DateTime                   @map("location_captured_at")
  visitedAt          DateTime                   @default(now()) @map("visited_at")
  recordedAtServer   DateTime                   @default(now()) @map("recorded_at_server")
  idempotencyKey     String                     @unique @map("idempotency_key")
  createdAt          DateTime                   @default(now()) @map("created_at")

  @@index([pointId, visitedAt])
  @@index([technicianId, visitedAt])
  @@map("non_maintenance_visits")
}

model PaperworkStatusHistory {
  id             String           @id @default(uuid()) @db.Uuid
  visitId        String           @map("visit_id") @db.Uuid
  visit          MaintenanceVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  kind           PaperworkKind
  previousStatus PaperworkStatus  @map("previous_status")
  newStatus      PaperworkStatus  @map("new_status")
  changedById    String           @map("changed_by_id") @db.Uuid
  changedBy      User             @relation("PaperworkChangedBy", fields: [changedById], references: [id])
  changedAt      DateTime         @default(now()) @map("changed_at")
  note           String?

  @@index([visitId, changedAt])
  @@index([changedById, changedAt])
  @@map("paperwork_status_history")
}

model MaintenanceReviewResolution {
  id             String           @id @default(uuid()) @db.Uuid
  visitId        String           @map("visit_id") @db.Uuid
  visit          MaintenanceVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  decision       ReviewDecision
  previousReason String?          @map("previous_reason")
  resolvedById   String           @map("resolved_by_id") @db.Uuid
  resolvedBy     User             @relation("ReviewResolvedBy", fields: [resolvedById], references: [id])
  resolvedAt     DateTime         @default(now()) @map("resolved_at")
  note           String?

  @@index([visitId, resolvedAt])
  @@index([resolvedById, resolvedAt])
  @@map("maintenance_review_resolutions")
}
