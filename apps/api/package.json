{
  "name": "@fmp/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:status": "prisma migrate status",
    "demo:seed": "set -a; . ../../.env; set +a; ts-node --compiler-options '{\"module\":\"commonjs\",\"moduleResolution\":\"node\"}' src/demo-data/demo-data.cli.ts seed",
    "demo:purge": "set -a; . ../../.env; set +a; ts-node --compiler-options '{\"module\":\"commonjs\",\"moduleResolution\":\"node\"}' src/demo-data/demo-data.cli.ts purge",
    "lint": "tsc --noEmit",
    "test:rut-schedule": "node --test --require ts-node/register src/common/rut-schedule.spec.ts src/common/smartclean-schedule.spec.ts",
    "test:demo-data": "node --test --require ts-node/register src/demo-data/demo-data-plan.spec.ts",
    "test:effective-workload": "node --test --require ts-node/register src/ai/effective-workload.service.spec.ts",
    "test:assigned-workload": "node --test --require ts-node/register src/ai/assigned-weekly-workload.service.spec.ts",
    "test:weekly-workload": "node --test --require ts-node/register src/ai/weekly-workload.service.spec.ts",
    "test:geography": "node --test --require ts-node/register src/ai/geography.service.spec.ts",
    "test:geography-clustering": "node --test --require ts-node/register src/ai/geography-clustering.service.spec.ts",
    "test:business-week": "node --test --require ts-node/register src/common/business-week.spec.ts",
    "test:data-maturity": "node --test --require ts-node/register src/ai/data-maturity.service.spec.ts",
    "test:cold-start": "node --test --require ts-node/register src/ai/cold-start.service.spec.ts",
    "test:point-difficulty": "node --test --require ts-node/register src/ai/point-difficulty.service.spec.ts",
    "test:difficulty-calibration": "node --test --require ts-node/register src/ai/difficulty-calibration.service.spec.ts",
    "test:technician-baseline": "node --test --require ts-node/register src/ai/technician-baseline.service.spec.ts",
    "prisma:validate": "cd ../.. && prisma validate --schema apps/api/prisma/schema.prisma",
    "test:point-address-discovery": "node --test --require ts-node/register src/points/point-address-discovery.service.spec.ts",
    "test:risk-engine": "node --test --require ts-node/register src/ai/risk-engine.service.spec.ts",
    "test:location-intelligence": "node --test --require ts-node/register src/ai/location-intelligence.service.spec.ts",
    "test:identity-confidence": "node --test --require ts-node/register src/ai/identity-confidence.service.spec.ts",
    "test:data-quality-engine": "node --test --require ts-node/register src/ai/data-quality-engine.service.spec.ts",
    "test:backtest": "node --test --require ts-node/register src/ai/backtest.service.spec.ts",
    "test:region-health": "node --test --require ts-node/register src/ai/region-health.service.spec.ts",
    "test:trends": "node --test --require ts-node/register src/ai/trend.service.spec.ts",
    "test:equipment-profile": "node --test --require ts-node/register src/ai/equipment-profile.service.spec.ts",
    "test:planning-engine": "node --test --require ts-node/register src/ai/planning-engine.service.spec.ts",
    "test:recommendation-feedback": "node --test --require ts-node/register src/ai/recommendation-feedback.service.spec.ts",
    "test:similar-week": "node --test --require ts-node/register src/ai/similar-week.service.spec.ts",
    "test:what-if": "node --test --require ts-node/register src/ai/what-if.service.spec.ts",
    "test:workload-calibration": "node --test --require ts-node/register src/ai/workload-calibration.service.spec.ts",
    "test:ai": "npm run test:rut-schedule && npm run test:effective-workload && npm run test:assigned-workload && npm run test:weekly-workload && npm run test:geography && npm run test:geography-clustering && npm run test:business-week && npm run test:data-maturity && npm run test:ai-output-policy && npm run test:ai-telemetry && npm run test:ai-distribution-drift && npm run test:cold-start && npm run test:point-difficulty && npm run test:difficulty-calibration && npm run test:technician-baseline && npm run test:point-address-discovery && npm run test:risk-engine && npm run test:location-intelligence && npm run test:identity-confidence && npm run test:data-quality-engine && npm run test:backtest && npm run test:region-health && npm run test:trends && npm run test:equipment-profile && npm run test:planning-engine && npm run test:recommendation-feedback && npm run test:similar-week && npm run test:what-if && npm run test:ai-summary && npm run test:feature-store && npm run test:workload-calibration && npm run test:service-workload-index && npm run test:ai-kpi-export && npm run test:ai-module && npm run test:ai-output-contract && npm run test:ai-contract",
    "test:ai-summary": "node --test --require ts-node/register src/ai/ai-summary.service.spec.ts",
    "test:feature-store": "node --test --require ts-node/register src/ai/feature-store.service.spec.ts",
    "test:ai-contract": "node --test --require ts-node/register src/ai/admin-ai.controller.contract.spec.ts",
    "test:ai-output-policy": "node --test --require ts-node/register src/ai/ai-output-policy.spec.ts",
    "test:ai-telemetry": "node --test --require ts-node/register src/ai/ai-telemetry.service.spec.ts",
    "test:ai-distribution-drift": "node --test --require ts-node/register src/ai/ai-distribution-drift.service.spec.ts",
    "test:ai-kpi-export": "node --test --require ts-node/register src/ai/ai-kpi-export.service.spec.ts",
    "test:ai-output-contract": "node --test --require ts-node/register src/ai/ai-output-contract.spec.ts",
    "test:ai-module": "node --test --require ts-node/register src/ai/ai.module.spec.ts",
    "test:service-workload-index": "node --test --require ts-node/register src/ai/service-workload-index.spec.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@prisma/client": "^6.15.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.7",
    "@nestjs/testing": "^11.1.6",
    "@types/node": "^24.3.1",
    "prisma": "^6.15.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
