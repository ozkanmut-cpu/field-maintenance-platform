# Application
NODE_ENV=development
API_PORT=3000
ADMIN_PORT=3001

# PostgreSQL / PostGIS
POSTGRES_DB=field_maintenance
POSTGRES_USER=field_maintenance
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql://field_maintenance:change-me-local-only@localhost:5432/field_maintenance

# Maintenance calendar
# Set this to a real Monday that your operation defines as a STANDARD "1. HAFTA".
STANDARD_WEEK1_ANCHOR=2026-01-05

# Anti-batch / anomaly thresholds
ANTI_BATCH_WINDOW_MINUTES=12
ANTI_BATCH_STATIONARY_METERS=150
ANTI_BATCH_MAX_SPEED_KMH=160

# Conservative field location learning
LOCATION_MAX_ACCURACY_METERS=80
LOCATION_CLUSTER_RADIUS_METERS=120

# Security placeholders
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-another-long-random-secret

# Optional future integrations — leave empty locally
GOOGLE_MAPS_API_KEY=
SAP_BASE_URL=

# Public repo rule:
# Never place production secrets, SAP credentials, session cookies,
# customer exports or server credentials in this file or in git.
