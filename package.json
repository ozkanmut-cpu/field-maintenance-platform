{
  "name": "field-maintenance-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "services/*"
  ],
  "scripts": {
    "dev:api": "npm run start:dev -w @fmp/api",
    "build:api": "npm run build -w @fmp/api",
